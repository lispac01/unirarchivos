@model IReadOnlyCollection<TrPreviajeContenedor>

@{
    ViewData["Title"] = "Previaje de contenedores";
}

<section class="page-hero mb-4">
    <div>
        <span class="page-kicker">Transacciones</span>
        <h1 class="page-title">Previaje de contenedores</h1>
        <p class="page-subtitle mb-0">Realiza la inspección por especialidad para determinar si el contenedor queda habilitado o no.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="PreviajesContenedor" asp-action="Create" class="btn btn-primary btn-lg">Nuevo previaje</a>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <section class="empty-state">
        <div class="empty-state__icon">PR</div>
        <h2 class="h4 mb-2">Todavia no hay previajes registrados</h2>
        <p class="text-muted mb-4">Registra el primer previaje después del ingreso para continuar el flujo del mantenimiento.</p>
        <a asp-controller="PreviajesContenedor" asp-action="Create" class="btn btn-primary">Crear primer previaje</a>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 app-table">
                <thead>
                    <tr>
                        <th>Previaje</th>
                        <th>Ingreso</th>
                        <th>Contenedor</th>
                        <th>Cliente</th>
                        <th>Especialidad</th>
                        <th>Técnico</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var previaje in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@previaje.NroPreviaje</td>
                            <td>@previaje.NumIngreso</td>
                            <td>@(previaje.Ingreso?.Contenedor?.CodContenedor ?? "-")</td>
                            <td>@(previaje.Ingreso?.Contenedor?.Cliente?.NombreCliente ?? previaje.Ingreso?.Contenedor?.CodCliente ?? "-")</td>
                            <td>@(previaje.Especialidad?.NomEspMtto ?? previaje.CodEspMtto)</td>
                            <td>@(previaje.Tecnico?.NomTit ?? previaje.CodTit)</td>
                            <td>@previaje.FecPreviaje.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (previaje.Habilitado)
                                {
                                    <span class="badge rounded-pill text-bg-success">Habilitado</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-danger">No habilitado</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="PreviajesContenedor" asp-action="Edit" asp-route-id="@previaje.NroPreviaje" class="btn btn-outline-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
