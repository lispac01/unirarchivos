@model IReadOnlyCollection<CtMContenedor>

@{
    ViewData["Title"] = "Maestro de contenedores";
}

<section class="page-hero mb-4">
    <div>
        <span class="page-kicker">Catalogo maestro</span>
        <h1 class="page-title">Maestro de contenedores</h1>
        <p class="page-subtitle mb-0">Administra el catalogo <strong>ct_mcontenedor</strong> y registra los contenedores disponibles por cliente.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Contenedores" asp-action="Create" class="btn btn-primary btn-lg">Nuevo contenedor</a>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="summary-card">
            <span class="summary-label">Total registrados</span>
            <strong class="summary-value">@Model.Count</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <span class="summary-label">Activos</span>
            <strong class="summary-value">@Model.Count(x => x.Activo)</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="summary-card">
            <span class="summary-label">Inactivos</span>
            <strong class="summary-value">@Model.Count(x => !x.Activo)</strong>
        </div>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <section class="empty-state">
        <div class="empty-state__icon">CT</div>
        <h2 class="h4 mb-2">Todavia no hay contenedores registrados</h2>
        <p class="text-muted mb-4">Empieza creando el primer contenedor para alimentar el maestro y despues continuar con el resto del mantenimiento.</p>
        <a asp-controller="Contenedores" asp-action="Create" class="btn btn-primary">Crear primer contenedor</a>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 app-table">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th>Codigo cliente</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contenedor in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@contenedor.CodContenedor</td>
                            <td>@contenedor.Nombre</td>
                            <td>@contenedor.CodCliente</td>
                            <td>
                                @if (contenedor.Activo)
                                {
                                    <span class="badge rounded-pill text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Contenedores" asp-action="Edit" asp-route-id="@contenedor.CodContenedor" class="btn btn-outline-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
