@model IReadOnlyCollection<CtEspDelEmp>

@{
    ViewData["Title"] = "Especialidades del técnico";
}

<section class="page-hero mb-4">
    <div>
        <span class="page-kicker">Catalogo maestro</span>
        <h1 class="page-title">Especialidades del técnico</h1>
        <p class="page-subtitle mb-0">Administra <strong>ct_espdelemp</strong> y asigna una especialidad del maestro <strong>ct_espmtto</strong> a cada técnico.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="EspecialidadesEmpleado" asp-action="Create" class="btn btn-primary btn-lg">Nuevo técnico</a>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <section class="empty-state">
        <div class="empty-state__icon">TE</div>
        <h2 class="h4 mb-2">Todavia no hay técnicos registrados</h2>
        <p class="text-muted mb-4">Crea el primer técnico y asígnale una especialidad de mantenimiento.</p>
        <a asp-controller="EspecialidadesEmpleado" asp-action="Create" class="btn btn-primary">Crear primer técnico</a>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 app-table">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Especialidad</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tecnico in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@tecnico.CodTit</td>
                            <td>@tecnico.NomTit</td>
                            <td>@tecnico.Usuario</td>
                            <td>@(tecnico.EspecialidadesAsignadas.FirstOrDefault()?.Especialidad?.NomEspMtto ?? tecnico.EspecialidadesAsignadas.FirstOrDefault()?.CodEspMtto ?? "-")</td>
                            <td class="text-end">
                                <a asp-controller="EspecialidadesEmpleado" asp-action="Edit" asp-route-id="@tecnico.CodTit" class="btn btn-outline-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
