@model EspecialidadEmpleadoFormViewModel

@{
    ViewData["Title"] = "Editar técnico";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="page-kicker">Edicion</span>
                <h1 class="page-title mb-1">Especialidades del técnico</h1>
                <p class="text-muted mb-0">Actualiza los datos del técnico y corrige su especialidad asignada.</p>
            </div>
            <a asp-controller="EspecialidadesEmpleado" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <div class="data-card form-card">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Edit" asp-route-id="@Model.CodTit" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label asp-for="CodTit" class="form-label fw-semibold"></label>
                            <input asp-for="CodTit" class="form-control form-control-lg" readonly />
                            <span asp-validation-for="CodTit" class="text-danger"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="NomTit" class="form-label fw-semibold"></label>
                            <input asp-for="NomTit" class="form-control form-control-lg" placeholder="Nombre del técnico" />
                            <span asp-validation-for="NomTit" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Usuario" class="form-label fw-semibold"></label>
                            <input asp-for="Usuario" class="form-control form-control-lg" placeholder="Usuario" />
                            <span asp-validation-for="Usuario" class="text-danger"></span>
                        </div>
                    </div>

                    <fieldset class="assignment-panel">
                        <legend class="assignment-panel__title">Especialidades del técnico</legend>

                        @if (Model.EspecialidadesDisponibles.Count == 0)
                        {
                            <div class="alert alert-warning mb-0" role="alert">
                                No hay especialidades disponibles para asignar en este momento.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0 app-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 90px;">Elegir</th>
                                            <th>Codigo</th>
                                            <th>Especialidad</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var especialidad in Model.EspecialidadesDisponibles)
                                        {
                                            <tr>
                                                <td>
                                                    <input class="form-check-input" type="radio" asp-for="CodEspMttoSeleccionado" value="@especialidad.CodEspMtto" />
                                                </td>
                                                <td class="fw-semibold">@especialidad.CodEspMtto</td>
                                                <td>@especialidad.NomEspMtto</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <span asp-validation-for="CodEspMttoSeleccionado" class="text-danger d-block mt-3"></span>
                        }
                    </fieldset>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-controller="EspecialidadesEmpleado" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
