@model CtClienteMtto

@{
    ViewData["Title"] = "Editar cliente";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="page-kicker">Edicion</span>
                <h1 class="page-title mb-1">Editar cliente</h1>
                <p class="text-muted mb-0">Actualiza los datos del maestro <strong>ct_clientemtto</strong>.</p>
            </div>
            <a asp-controller="ClientesMtto" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <div class="data-card form-card">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Edit" asp-route-id="@Model.CodCliente" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="CodCliente" class="form-label fw-semibold"></label>
                            <input asp-for="CodCliente" class="form-control form-control-lg" readonly />
                            <span asp-validation-for="CodCliente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CodDpto" class="form-label fw-semibold"></label>
                            <input asp-for="CodDpto" class="form-control form-control-lg" placeholder="Ej. CC-200" />
                            <span asp-validation-for="CodDpto" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="NombreCliente" class="form-label fw-semibold"></label>
                            <input asp-for="NombreCliente" class="form-control form-control-lg" placeholder="Nombre del cliente" />
                            <span asp-validation-for="NombreCliente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImpMovMo" class="form-label fw-semibold"></label>
                            <input asp-for="ImpMovMo" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.00" />
                            <span asp-validation-for="ImpMovMo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImpMovMo2" class="form-label fw-semibold"></label>
                            <input asp-for="ImpMovMo2" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.00" />
                            <span asp-validation-for="ImpMovMo2" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-4 mb-4">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-controller="ClientesMtto" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
