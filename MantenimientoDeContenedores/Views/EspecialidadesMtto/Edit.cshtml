@model CtEspMtto

@{
    ViewData["Title"] = "Editar especialidad";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="page-kicker">Edicion</span>
                <h1 class="page-title mb-1">Editar especialidad</h1>
                <p class="text-muted mb-0">Actualiza los datos del maestro <strong>ct_espmtto</strong>.</p>
            </div>
            <a asp-controller="EspecialidadesMtto" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <div class="data-card form-card">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Edit" asp-route-id="@Model.CodEspMtto" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <label asp-for="CodEspMtto" class="form-label fw-semibold"></label>
                            <input asp-for="CodEspMtto" class="form-control form-control-lg" readonly />
                            <span asp-validation-for="CodEspMtto" class="text-danger"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="NomEspMtto" class="form-label fw-semibold"></label>
                            <input asp-for="NomEspMtto" class="form-control form-control-lg" placeholder="Nombre de la especialidad" />
                            <span asp-validation-for="NomEspMtto" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-controller="EspecialidadesMtto" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
