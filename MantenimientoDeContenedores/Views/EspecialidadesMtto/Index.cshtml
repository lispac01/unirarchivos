@model IReadOnlyCollection<CtEspMtto>

@{
    ViewData["Title"] = "Especialidades de mantenimiento";
}

<section class="page-hero mb-4">
    <div>
        <span class="page-kicker">Catalogo maestro</span>
        <h1 class="page-title">Especialidades de mantenimiento</h1>
        <p class="page-subtitle mb-0">Administra el maestro <strong>ct_espmtto</strong> con el código y nombre de cada especialidad.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="EspecialidadesMtto" asp-action="Create" class="btn btn-primary btn-lg">Nueva especialidad</a>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <section class="empty-state">
        <div class="empty-state__icon">ES</div>
        <h2 class="h4 mb-2">Todavia no hay especialidades registradas</h2>
        <p class="text-muted mb-4">Crea la primera especialidad de mantenimiento para iniciar este maestro.</p>
        <a asp-controller="EspecialidadesMtto" asp-action="Create" class="btn btn-primary">Crear primera especialidad</a>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 app-table">
                <thead>
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var especialidad in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@especialidad.CodEspMtto</td>
                            <td>@especialidad.NomEspMtto</td>
                            <td class="text-end">
                                <a asp-controller="EspecialidadesMtto" asp-action="Edit" asp-route-id="@especialidad.CodEspMtto" class="btn btn-outline-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
