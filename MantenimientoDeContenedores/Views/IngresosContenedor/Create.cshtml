@model TrIngresoContenedor

@{
    ViewData["Title"] = "Nuevo ingreso";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="page-kicker">Nueva transaccion</span>
                <h1 class="page-title mb-1">Nuevo ingreso de contenedor</h1>
                <p class="text-muted mb-0">Registra el contenedor y la fecha/hora de ingreso.</p>
            </div>
            <a asp-controller="IngresosContenedor" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <div class="data-card form-card">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="CodContenedor" class="form-label fw-semibold"></label>
                            <select asp-for="CodContenedor" asp-items="ViewBag.Contenedores" class="form-select form-select-lg">
                                <option value="">Selecciona un contenedor</option>
                            </select>
                            <span asp-validation-for="CodContenedor" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FecIngreso" class="form-label fw-semibold"></label>
                            <input asp-for="FecIngreso" type="datetime-local" class="form-control form-control-lg" value="@Model.FecIngreso.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="FecIngreso" class="text-danger"></span>
                        </div>
                    </div>

                    @if (!(ViewBag.HasContenedores ?? false))
                    {
                        <div class="alert alert-warning mt-4" role="alert">
                            Debes crear al menos un contenedor activo en <a asp-controller="Contenedores" asp-action="Create" class="alert-link">ct_mcontenedor</a> antes de registrar ingresos.
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        @if (ViewBag.HasContenedores ?? false)
                        {
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary" disabled>Guardar</button>
                        }

                        <a asp-controller="IngresosContenedor" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
