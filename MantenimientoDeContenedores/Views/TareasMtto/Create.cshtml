@model CtTareaDeMtto

@{
    ViewData["Title"] = "Nueva tarea";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <span class="page-kicker">Nuevo registro</span>
                <h1 class="page-title mb-1">Nueva tarea de mantenimiento</h1>
                <p class="text-muted mb-0">Completa los datos del maestro <strong>ct_tareademtto</strong>.</p>
            </div>
            <a asp-controller="TareasMtto" asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <div class="data-card form-card">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-4">
                        <div class="col-md-3">
                            <label asp-for="NroTarea" class="form-label fw-semibold"></label>
                            <input asp-for="NroTarea" type="number" min="1" class="form-control form-control-lg" placeholder="Ej. 821" />
                            <span asp-validation-for="NroTarea" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="NombreTarea" class="form-label fw-semibold"></label>
                            <input asp-for="NombreTarea" class="form-control form-control-lg" placeholder="Nombre descriptivo de la tarea" />
                            <span asp-validation-for="NombreTarea" class="text-danger"></span>
                        </div>

                        <div class="col-md-1">
                            <label asp-for="Activo" class="form-label fw-semibold d-block">&nbsp;</label>
                            <div class="form-check form-switch mt-2">
                                <input asp-for="Activo" class="form-check-input" />
                                <label asp-for="Activo" class="form-check-label"></label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CodEspMtto" class="form-label fw-semibold"></label>
                            <select asp-for="CodEspMtto" asp-items="ViewBag.Especialidades" class="form-select form-select-lg">
                                <option value="">Selecciona una especialidad</option>
                            </select>
                            <span asp-validation-for="CodEspMtto" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TiempoEstimado" class="form-label fw-semibold"></label>
                            <input asp-for="TiempoEstimado" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="0.50" />
                            <span asp-validation-for="TiempoEstimado" class="text-danger"></span>
                        </div>
                    </div>

                    @if (!(ViewBag.HasEspecialidades ?? false))
                    {
                        <div class="alert alert-warning mt-4" role="alert">
                            Debes crear al menos una especialidad en <a asp-controller="EspecialidadesMtto" asp-action="Create" class="alert-link">ct_espmtto</a> antes de registrar tareas.
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        @if (ViewBag.HasEspecialidades ?? false)
                        {
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary" disabled>Guardar</button>
                        }

                        <a asp-controller="TareasMtto" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
