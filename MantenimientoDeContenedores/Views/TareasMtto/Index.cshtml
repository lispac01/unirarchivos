@model IReadOnlyCollection<CtTareaDeMtto>

@{
    ViewData["Title"] = "Tareas de mantenimiento";
}

<section class="page-hero mb-4">
    <div>
        <span class="page-kicker">Catalogo maestro</span>
        <h1 class="page-title">Tareas de mantenimiento</h1>
        <p class="page-subtitle mb-0">Administra el maestro <strong>ct_tareademtto</strong> con la tarea, su especialidad, tiempo estimado y estado.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="TareasMtto" asp-action="Create" class="btn btn-primary btn-lg">Nueva tarea</a>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <section class="empty-state">
        <div class="empty-state__icon">TA</div>
        <h2 class="h4 mb-2">Todavia no hay tareas registradas</h2>
        <p class="text-muted mb-4">Crea la primera tarea de mantenimiento para continuar con los procesos del taller.</p>
        <a asp-controller="TareasMtto" asp-action="Create" class="btn btn-primary">Crear primera tarea</a>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 app-table">
                <thead>
                    <tr>
                        <th>Nro.</th>
                        <th>Nombre de tarea</th>
                        <th>Especialidad</th>
                        <th>Tiempo estimado</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tarea in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@tarea.NroTarea</td>
                            <td>@tarea.NombreTarea</td>
                            <td>@(tarea.Especialidad?.NomEspMtto ?? tarea.CodEspMtto)</td>
                            <td>@tarea.TiempoEstimado.ToString("N2")</td>
                            <td>
                                @if (tarea.Activo)
                                {
                                    <span class="badge rounded-pill text-bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="TareasMtto" asp-action="Edit" asp-route-id="@tarea.NroTarea" class="btn btn-outline-primary btn-sm">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
